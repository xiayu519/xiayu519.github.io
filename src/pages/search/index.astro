---
import PageLayout from '../../layouts/PageLayout.astro';
---

<PageLayout title="搜索">
	<p class="page-lead">在站内搜索文章标题与正文。</p>
	<div class="search-box">
		<input
			id="search-input"
			class="search-input"
			type="search"
			placeholder="输入关键词，例如 Tyou、Cocos、AGENTS…"
			autocomplete="off"
			aria-label="搜索文章"
		/>
		<p id="search-status" class="search-status" role="status" aria-live="polite"></p>
		<div id="search-results"></div>
	</div>
</PageLayout>

<style>
	.search-box {
		margin-top: 0.5rem;
	}
	.search-status {
		margin: 0.75rem 0;
		color: var(--text-subtle);
		font-size: 0.88rem;
		min-height: 1.2em;
	}
</style>

<script>
	const input = document.getElementById('search-input') as HTMLInputElement | null;
	const status = document.getElementById('search-status');
	const results = document.getElementById('search-results');

	type PagefindResult = {
		id: string;
		data: () => Promise<{
			url: string;
			excerpt: string;
			meta: { title?: string; description?: string };
		}>;
	};

	let pagefind: { search: (q: string) => Promise<{ results: PagefindResult[] }> } | null = null;
	let ready = false;

	async function load() {
		if (ready) return;
		const PAGEFIND = '/pagefind/pagefind.js';
		// 由构建期 `pagefind --site dist` 生成；用变量 + @vite-ignore 避免构建期被 Vite 解析。
		pagefind = await import(/* @vite-ignore */ PAGEFIND);
		ready = true;
	}

	async function run(query: string) {
		if (!results || !status) return;
		if (!query.trim()) {
			results.innerHTML = '';
			status.textContent = '';
			return;
		}
		if (!ready) status.textContent = '正在加载搜索索引…';
		await load();
		if (!pagefind) {
			status.textContent = '搜索索引不可用，请在构建后访问。';
			return;
		}
		const search = await pagefind.search(query);
		status.textContent = `找到 ${search.results.length} 条结果`;
		const top = search.results.slice(0, 20);
		const rendered = await Promise.all(top.map((r) => r.data()));
		results.innerHTML = rendered
			.map(
				(item) => `
				<div class="search-result">
					<a href="${item.url}">${item.meta?.title ?? '(无标题)'}</a>
					${item.meta?.description ? `<p>${item.meta.description}</p>` : ''}
				</div>`,
			)
			.join('');
	}

	let timer: ReturnType<typeof setTimeout> | undefined;
	input?.addEventListener('input', () => {
		clearTimeout(timer);
		timer = setTimeout(() => run(input.value), 180);
	});
</script>
