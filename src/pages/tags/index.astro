---
import PageLayout from '../../layouts/PageLayout.astro';
import { countTaxonomy, slugify } from '../../utils/posts';
import { getPublishedPosts } from '../../utils/posts';

const posts = await getPublishedPosts();
const tags = countTaxonomy(posts, 'tags');
---

<PageLayout title="标签">
	<p class="page-lead">{tags.size} 个标签，共 {posts.length} 篇文章。</p>
	<ul class="chip-list">
		{[...tags.entries()].map(([name, count]) => (
			<li>
				<a class="chip" href={`/tags/${slugify(name)}/`}>
					#{name}<span class="num">{count}</span>
				</a>
			</li>
		))}
	</ul>
</PageLayout>
