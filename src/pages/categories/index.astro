---
import PageLayout from '../../layouts/PageLayout.astro';
import { countTaxonomy, slugify } from '../../utils/posts';
import { getPublishedPosts } from '../../utils/posts';

const posts = await getPublishedPosts();
const categories = countTaxonomy(posts, 'category');
---

<PageLayout title="分类">
	<p class="page-lead">{categories.size} 个分类，共 {posts.length} 篇文章。</p>
	<ul class="chip-list">
		{[...categories.entries()].map(([name, count]) => (
			<li>
				<a class="chip" href={`/categories/${slugify(name)}/`}>
					{name}<span class="num">{count}</span>
				</a>
			</li>
		))}
	</ul>
</PageLayout>
