---
import PageLayout from '../../layouts/PageLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, slugify } from '../../utils/posts';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	const byCategory = new Map<string, typeof posts>();
	for (const post of posts) {
		const arr = byCategory.get(post.data.category) ?? [];
		arr.push(post);
		byCategory.set(post.data.category, arr);
	}
	return [...byCategory.entries()].map(([category, list]) => ({
		params: { slug: slugify(category) },
		props: { category, list },
	}));
}

const { category, list } = Astro.props;
---

<PageLayout title={`分类：${category}`}>
	<p class="page-lead">
		分类：<strong>{category}</strong> · 共 {list.length} 篇 · <a href="/categories/">← 所有分类</a>
	</p>
	<ul class="post-list">
		{list.map((post) => <li><PostCard post={post} /></li>)}
	</ul>
</PageLayout>
