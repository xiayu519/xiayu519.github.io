---
import { GITHUB_URL, NAV_ITEMS, SITE_SHORT_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header" data-pagefind-ignore>
	<div class="header-inner">
		<a class="brand" href="/" aria-label="返回首页">
			<span class="brand-mark">X</span>
			<span>{SITE_SHORT_TITLE}</span>
		</a>
		<nav aria-label="主导航">
			{NAV_ITEMS.map((item) => <HeaderLink href={item.href}>{item.label}</HeaderLink>)}
		</nav>
		<div class="header-actions">
			<a class="icon-link" href="/search/" aria-label="搜索" title="搜索">⌕</a>
			<a class="icon-link github" href={GITHUB_URL} target="_blank" rel="noreferrer" aria-label="GitHub" title="GitHub">
				<svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8z" /></svg>
			</a>
			<ThemeToggle />
		</div>
	</div>
</header>

<style>
	.site-header { position: sticky; top: 0; z-index: 20; border-bottom: 1px solid var(--border); background: color-mix(in srgb, var(--background) 88%, transparent); backdrop-filter: blur(18px); }
	.header-inner { display: flex; width: min(1180px, calc(100% - 2rem)); min-height: 4.25rem; margin: 0 auto; align-items: center; gap: 1.5rem; }
	.brand { display: flex; flex: 0 0 auto; align-items: center; gap: .65rem; color: var(--text-strong); font-size: 1rem; font-weight: 800; text-decoration: none; letter-spacing: .02em; }
	.brand-mark { display: grid; width: 2rem; height: 2rem; place-items: center; border-radius: .65rem; background: var(--accent); color: white; font-weight: 900; }
	nav { display: flex; flex: 1; align-items: center; gap: .15rem; }
	nav :global(a) { padding: .55rem .65rem; border-radius: .55rem; color: var(--text-muted); font-size: .88rem; font-weight: 650; text-decoration: none; white-space: nowrap; }
	nav :global(a:hover), nav :global(a.active) { background: var(--surface-strong); color: var(--text-strong); }
	.header-actions { display: flex; flex: 0 0 auto; align-items: center; gap: .45rem; }
	.icon-link { display: grid; width: 2.25rem; height: 2.25rem; place-items: center; border: 1px solid var(--border); border-radius: 999px; color: var(--text); text-decoration: none; }
	.icon-link:hover { border-color: var(--accent); color: var(--accent); }
	.icon-link svg { width: 1rem; height: 1rem; }
	@media (max-width: 900px) { .header-inner { flex-wrap: wrap; padding: .65rem 0; gap: .6rem 1rem; } nav { order: 3; width: 100%; overflow-x: auto; } .header-actions { margin-left: auto; } }
	@media (max-width: 520px) { .github { display: none; } }
</style>
