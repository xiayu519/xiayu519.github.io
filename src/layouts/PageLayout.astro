---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
	title?: string;
	description?: string;
	wide?: boolean;
}

const { title, description = SITE_DESCRIPTION, wide = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
---

<!doctype html>
<html lang="zh-CN">
	<head><BaseHead title={pageTitle} description={description} /></head>
	<body>
		<Header />
		<main class:list={['page-shell', { wide }]}><slot /></main>
		<Footer />
	</body>
</html>
