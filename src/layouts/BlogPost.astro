---
import { Image } from 'astro:assets';
import type { BlogPost } from '../utils/posts';
import { getPostUrl, getPublishedPosts, getReadingMinutes, slugify } from '../utils/posts';
import BaseHead from '../components/BaseHead.astro';
import Comments from '../components/Comments.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_AUTHOR } from '../consts';

interface Props {
	post: BlogPost;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, category, tags } = post.data;

const posts = await getPublishedPosts();
const index = posts.findIndex((p) => p.id === post.id);
const newer = index > 0 ? posts[index - 1] : undefined;
const older = index >= 0 && index < posts.length - 1 ? posts[index + 1] : undefined;
const minutes = getReadingMinutes(post.body);

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageSrc = heroImage ? heroImage.src : '/social-card.png';
const socialImage = new URL(imageSrc, Astro.site).toString();
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${title} · xiayu519`} description={description} image={heroImage} type="article" />
		<meta property="article:published_time" content={pubDate.toISOString()} />
		{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
		<meta property="article:author" content={SITE_AUTHOR} />
		<meta property="article:section" content={category} />
		{tags.map((tag) => <meta property="article:tag" content={tag} />)}
		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				'@context': 'https://schema.org',
				'@type': 'BlogPosting',
				headline: title,
				description,
				datePublished: pubDate.toISOString(),
				dateModified: (updatedDate ?? pubDate).toISOString(),
				author: { '@type': 'Person', name: SITE_AUTHOR },
				publisher: { '@type': 'Person', name: SITE_AUTHOR },
				mainEntityOfPage: canonicalURL.toString(),
				url: canonicalURL.toString(),
				image: [socialImage],
				keywords: tags.join(', '),
			})}
		/>
		<style>
			main {
				width: min(760px, calc(100% - 2rem));
				margin: 0 auto;
				padding: 2.5rem 0 1rem;
			}
			.hero-image {
				margin: 0 0 1.5rem;
			}
			.hero-image img {
				width: 100%;
				border-radius: var(--radius);
				box-shadow: var(--shadow-md);
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				{heroImage && (
					<div class="hero-image">
						<Image width={1020} height={510} src={heroImage} alt={title} />
					</div>
				)}
				<div class="post-header">
					<div class="post-meta">
						<a href={`/categories/${slugify(category)}/`}>{category}</a>
						<span>·</span>
						<FormattedDate date={pubDate} />
						<span>·</span>
						<span>{minutes} 分钟阅读</span>
						{updatedDate && (
							<span>· 更新于 <FormattedDate date={updatedDate} /></span>
						)}
					</div>
					<h1>{title}</h1>
					<p class="page-lead" style="margin-bottom:0">{description}</p>
				</div>

				<div class="prose">
					<slot />
				</div>

				{tags.length > 0 && (
					<div class="post-tags">
						{tags.map((tag) => <a href={`/tags/${slugify(tag)}/`}>#{tag}</a>)}
					</div>
				)}

				<nav class="post-nav" aria-label="文章导航">
					{newer ? (
						<div>
							<a href={getPostUrl(newer)}>
								<span class="label">← 上一篇</span>
								<span class="title">{newer.data.title}</span>
							</a>
						</div>
					) : <div />}
					{older ? (
						<div class="next">
							<a href={getPostUrl(older)}>
								<span class="label">下一篇 →</span>
								<span class="title">{older.data.title}</span>
							</a>
						</div>
					) : <div class="next" />}
				</nav>

				<Comments />
			</article>
		</main>
		<Footer />
	</body>
</html>
